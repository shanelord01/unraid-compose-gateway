# Required. A long random value - every request must send it back as
# "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
GATEWAY_TOKEN=

# Required for compose control. Comma-separated compose project names this
# instance is allowed to act on at all. Each name must match a subdirectory
# under COMPOSE_PROJECTS_DIR containing a docker-compose.yml.
ALLOWED_PROJECTS=

# Names from ALLOWED_PROJECTS that mutating endpoints (restart/up/down) must
# always refuse, regardless of what the caller asks for. Use this for the
# project that contains the agent calling this API, and anything sharing its
# network namespace, so a compromised or misbehaving client cannot control
# its own container through this sidecar.
SELF_EXCLUDE_PROJECTS=

# Base directory holding one subdirectory per compose project. Mount this
# read-only from the host path where your compose projects actually live.
COMPOSE_PROJECTS_DIR=/compose-projects

# Optional. Enables the /v1/plugins/updates endpoint (Unraid only). Mount
# read-only from the host's /boot/config/plugins directory. Leave unset to
# disable plugin update checking entirely.
PLUGIN_DIR=

# Optional. Seconds to cache plugin update results before re-checking
# upstream. Default 1800 (30 minutes).
PLUGIN_CACHE_SECONDS=1800

# Optional. Default and maximum number of log lines returned by
# /v1/containers/{name}/logs. Defaults: 200 / 5000.
LOG_TAIL_DEFAULT=200
LOG_TAIL_MAX=5000

# Optional. Seconds to allow a `docker compose` invocation to run before
# giving up. Default 120.
COMPOSE_TIMEOUT_SECONDS=120

# Optional. Port the HTTP server listens on inside the container. Default
# 8080.
PORT=8080
